<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BMICalcStackBased.RecomPage"
             Title="RecomPage"
             NavigationPage.HasNavigationBar="False">
    <VerticalStackLayout
        BackgroundColor="White"
        Margin="20"
        Padding="15"
        Spacing="15"
        >
        <Label Text="Recommendations" TextColor="Black" FontSize="Large"/>
        <Label Text="Based on your BMI and gender it is recommended you:" TextColor="Black" FontSize="Medium" HorizontalOptions="Center"/>
        <Label x:Name="LblRecommendation" TextColor="Black" FontSize="Medium" FontAttributes="Bold" HorizontalOptions="Center"/>
        <Button Text="Return to BMI Results" Clicked="Button_Clicked_1" Background="Gray" TextColor="White" />
        <Button Text="Return to BMI Calculator" Clicked="Button_Clicked" BackgroundColor="Gray" TextColor="White" />
    </VerticalStackLayout>
</ContentPage>